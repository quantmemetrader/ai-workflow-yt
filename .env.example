# Session cookie signing key. Generate with: openssl rand -hex 32
TL_SECRET=change-me

# Where the SQLite file lives. Defaults to ./data locally and /tmp on
# serverless hosts, where nothing else is writable.
# TL_DB=/var/data/throughline.db

# Splitting the site from its data.
#
# This app keeps its state in SQLite and reads it synchronously, so it needs one
# machine with one disk. A serverless host gives every request a different one,
# and /tmp is reseeded on each cold start — a task created by one request does
# not exist for the next, which surfaces as "No such task."
#
# Set API_ORIGIN on the site deployment to point at the machine that owns the
# database. /api/* is proxied there, and the two pages that check a session
# server-side ask it instead of opening an empty local database.
#
# Set it ONLY on the site. The API host leaves it unset and holds TL_DB and
# TL_SECRET, since it is the only thing that validates a session cookie.
# API_ORIGIN=https://api.your-domain.com

# Optional. With a key the model gateway calls Claude; without one it uses a
# deterministic rules provider that exercises the same workflow.
# ANTHROPIC_API_KEY=

# Optional. With a key, topic discovery searches YouTube for what is actually
# going viral, and a published video can be read back for its views, likes and
# comments. Without one, discovery uses a deterministic catalogue and readback
# reports its fields as uncollected rather than inventing numbers.
# YOUTUBE_API_KEY=

# Points the YouTube calls somewhere else. Only useful for testing the readback
# path without calling Google.
# YOUTUBE_API_BASE=http://localhost:3399
