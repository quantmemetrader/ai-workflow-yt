# Nothing is wired up yet — this file documents the shape the real build will
# need, per 01_Build-Spec 2.pdf. None of these are read by any code today.

# Postgres 16 (§1 Architecture)
# DATABASE_URL=

# Redis-backed job queue (§1, §6 Job pipeline)
# REDIS_URL=

# S3-compatible object storage for media, renders, and exports (§1, §7.1)
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_KEY=
# OBJECT_STORAGE_SECRET=

# ReBAC engine for content permissions — OpenFGA or SpiceDB (§2)
# OPENFGA_API_URL=
# OPENFGA_STORE_ID=

# LLM access, client-owned account, default aggregator (§5)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OIDC with the client's identity provider (§8 Auth)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
